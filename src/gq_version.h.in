#ifndef GQ_VERSION_H
#define GQ_VERSION_H

#define GQ_PACKAGE_NAME "@GQ_PACKAGE_NAME@"
#define GQ_PACKAGE_DESCRIPTION "@GQ_PACKAGE_DESCRIPTION_SUMMARY@"
#define GQ_PACKAGE_VERSION "@GQ_PACKAGE_VERSION@"
#define GQ_PACKAGE_VERSION_MAJOR @GQ_PACKAGE_VERSION_MAJOR@
#define GQ_PACKAGE_VERSION_MINOR @GQ_PACKAGE_VERSION_MINOR@
#define GQ_PACKAGE_VERSION_PATCH @GQ_PACKAGE_VERSION_PATCH@
#define GQ_PACKAGE_VERSION_STRING "@GQ_PACKAGE_NAME@ @GQ_PACKAGE_VERSION@"

#define GQ_VERSION "@PROJECT_VERSION@"
#define GQ_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define GQ_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define GQ_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define GQ_VERSION_STRING "@GQ_PACKAGE_NAME@ @PROJECT_VERSION@"

#endif /* GQ_VERSION_H */
