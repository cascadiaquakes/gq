set (manifest "@CMAKE_BINARY_DIR@/install_manifest.txt")

if (NOT EXISTS "${manifest}")
	message (FATAL_ERROR
		"Cannot uninstall GQ: ${manifest} does not exist. Install GQ first.")
endif ()

file (STRINGS "${manifest}" installed_files)
foreach (installed_file IN LISTS installed_files)
	set (path "$ENV{DESTDIR}${installed_file}")
	if (EXISTS "${path}" OR IS_SYMLINK "${path}")
		message (STATUS "Removing ${path}")
		file (REMOVE "${path}")
	else ()
		message (STATUS "Already absent: ${path}")
	endif ()
endforeach ()
