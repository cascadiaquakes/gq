netcdf ssh_gaps2d {
dimensions:
	y = 5 ;
	x = 5 ;
variables:
	double y(y) ;
		y:axis = "Y" ;
	double x(x) ;
		x:axis = "X" ;
	float vp(y, x) ;
		vp:_FillValue = NaNf ;
	float quality(y, x) ;
	int model_id ;
data:
	y = 0, 1, 2, 3, 4 ;
	x = 0, 1, 2, 3, 4 ;
	vp = _,   100, 100, 100, 100,
	     100, 100, 100, 100, 100,
	     100, 100, _,   100, 100,
	     100, 100, 100, 100, 100,
	     100, 100, 100, 100, 100 ;
	quality = 7, 7, 7, 7, 7,
	          7, 7, 7, 7, 7,
	          7, 7, 7, 7, 7,
	          7, 7, 7, 7, 7,
	          7, 7, 7, 7, 7 ;
	model_id = 42 ;
}
